# Public API origin; never put server secrets into VITE_ variables.
VITE_API_URL=http://localhost:3000/api

# Reserved for the verified-ad integration stage. Missing ID does not simulate an ad.
VITE_ADSGRAM_BLOCK_ID=

# Optional local development identity; blank means no development header is sent.
# Backend must independently enable the development-only bypass.
VITE_DEV_TELEGRAM_USER_ID=
