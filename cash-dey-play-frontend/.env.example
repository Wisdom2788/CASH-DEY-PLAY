# Frontend environment variables template
# Copy this file to .env and fill in your values

# Backend API URL (include /api suffix)
VITE_API_URL=http://localhost:3000/api

# AdsGram block ID (for rewarded video ads)
VITE_ADSGRAM_BLOCK_ID=

# Staging builds only: allow the built-in fake 5-second ad when no real Adsgram block ID is set.
# Production builds FAIL without a real VITE_ADSGRAM_BLOCK_ID unless this is "true".
VITE_ALLOW_MOCK_ADS=false
