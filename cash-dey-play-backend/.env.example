# --- Server ---
PORT=3000
# Explicit on purpose. Anything other than "development" or "test" (including empty) is treated as production.
NODE_ENV=development

# --- Data ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cash_dey_play
# Required in production (shared rate limits). Leave empty locally to use in-process limits.
REDIS_URL=

# --- Telegram ---
# The token of the SAME bot that owns the Mini App (@Cash_dey_play_bot). Never commit it.
TELEGRAM_BOT_TOKEN=

# --- Security ---
# Production: random value of at least 32 characters, e.g. generate with:  openssl rand -hex 32
# Development/test: may be left empty.
JWT_SECRET=
# The web address of the app (the Vercel URL in production).
CORS_ORIGIN=http://localhost:5173
# Developer sign-in shortcut. Only honoured when NODE_ENV=development. Keep false unless you need it locally.
ALLOW_DEV_AUTH_BYPASS=false

# --- Rate limits ---
USER_REQUESTS_PER_MINUTE=60
IP_REQUESTS_PER_MINUTE=120

# Set to the verified number of reverse-proxy hops for your backend ingress; default 0.
TRUST_PROXY_HOPS=0
